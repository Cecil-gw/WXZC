# 保险精准营销系统 Insurance AI · 环境变量模板
# 使用方式：复制为 .env 后按需修改；.env 已在 .gitignore 中忽略
# 变量来源：docs/04_技术框架方案.md §6.5 / §3 技术选型；docs/02_AI技术方案.md §3.2

# ========== 应用 ==========
APP_ENV=dev
DEBUG=true
HOST=0.0.0.0
PORT=5000

# ========== 数据库 ==========
# 教学环境默认 SQLite；生产可切换为 mysql+pymysql://... 或 postgresql+psycopg://...
DATABASE_URL=sqlite:///instance/insurance.db

# ========== JWT & 安全 ==========
# 生产必须替换为高强度随机字符串
JWT_SECRET_KEY=change-me-please-use-a-long-random-string
JWT_ALGORITHM=HS256
# Token 有效期（秒），默认 24 小时
JWT_EXPIRE_SECONDS=86400

# ========== 默认管理员（首次启动 seed） ==========
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ========== 大模型（OpenAI 兼容协议） ==========
# 未配置 API_KEY 时 LLM 服务降级为 status=failed，业务照常运行
LLM_API_KEY=
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-flash
LLM_TEMPERATURE=0.7

# ========== 模型与数据目录 ==========
# 相对路径以项目根为基准；MODEL_DIR 会被解析为绝对路径
MODEL_DIR=data/models
