{
  "info": {
    "_postman_id": "insurance-ai-api-collection",
    "name": "保险精准营销系统 Insurance AI API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "包含已实现的所有接口：认证、数据管理、模型训练。基础URL: http://127.0.0.1:5000/api/v1"
  },
  "item": [
    {
      "name": "🔑 认证模块",
      "item": [
        {
          "name": "用户登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "登录获取 JWT Token。默认管理员账号：admin / admin123"
          },
          "response": []
        },
        {
          "name": "获取当前用户信息",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "需要 Token 鉴权"
          },
          "response": []
        },
        {
          "name": "用户注册",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"testuser\",\n    \"password\": \"test123456\",\n    \"email\": \"test@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "注册普通用户"
          },
          "response": []
        }
      ]
    },
    {
      "name": "📊 数据模块",
      "item": [
        {
          "name": "上传 Excel 文件",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/data/upload",
              "host": ["{{base_url}}"],
              "path": ["data", "upload"]
            },
            "description": "上传 Excel 文件 (.xlsx)。在 Postman 中选择 file 类型并上传文件。"
          },
          "response": []
        },
        {
          "name": "客户分页查询",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/data/customers?page=1&per_page=10&gender=&age_min=&age_max=&has_response=",
              "host": ["{{base_url}}"],
              "path": ["data", "customers"],
              "query": [
                { "key": "page", "value": "1", "description": "页码" },
                { "key": "per_page", "value": "10", "description": "每页数量" },
                {
                  "key": "gender",
                  "value": "",
                  "description": "性别: Male/Female",
                  "disabled": true
                },
                {
                  "key": "age_min",
                  "value": "",
                  "description": "最小年龄",
                  "disabled": true
                },
                {
                  "key": "age_max",
                  "value": "",
                  "description": "最大年龄",
                  "disabled": true
                },
                {
                  "key": "has_response",
                  "value": "",
                  "description": "是否有响应: 0/1",
                  "disabled": true
                }
              ]
            },
            "description": "支持多条件过滤的分页查询"
          },
          "response": []
        },
        {
          "name": "数据统计",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/data/statistics",
              "host": ["{{base_url}}"],
              "path": ["data", "statistics"]
            },
            "description": "总览统计：总数/性别分布/响应分布/年龄统计"
          },
          "response": []
        },
        {
          "name": "数据质量报告",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/data/quality",
              "host": ["{{base_url}}"],
              "path": ["data", "quality"]
            },
            "description": "缺失值/重复/类型检查"
          },
          "response": []
        },
        {
          "name": "EDA 可视化 - 响应分布",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/data/visualization/response_distribution",
              "host": ["{{base_url}}"],
              "path": ["data", "visualization", "response_distribution"]
            },
            "description": "chart_type 可选: response_distribution, gender_response, age_distribution, premium_distribution"
          },
          "response": []
        },
        {
          "name": "EDA 可视化 - 性别响应",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/data/visualization/gender_response",
              "host": ["{{base_url}}"],
              "path": ["data", "visualization", "gender_response"]
            }
          },
          "response": []
        },
        {
          "name": "EDA 可视化 - 年龄分布",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/data/visualization/age_distribution",
              "host": ["{{base_url}}"],
              "path": ["data", "visualization", "age_distribution"]
            }
          },
          "response": []
        },
        {
          "name": "EDA 可视化 - 保费分布",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/data/visualization/premium_distribution",
              "host": ["{{base_url}}"],
              "path": ["data", "visualization", "premium_distribution"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "🤖 模型模块",
      "item": [
        {
          "name": "训练模型",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"models\": [\"logistic_regression\", \"random_forest\", \"xgboost\"],\n    \"test_size\": 0.2,\n    \"random_state\": 42,\n    \"params\": {\n      \"xgboost\": {\n        \"n_estimators\": 100,\n        \"max_depth\": 6\n      }\n    }\n}"
            },
            "url": {
              "raw": "{{base_url}}/model/train",
              "host": ["{{base_url}}"],
              "path": ["model", "train"]
            },
            "description": "管理员权限，训练三种算法并选择最佳模型"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ]
}
